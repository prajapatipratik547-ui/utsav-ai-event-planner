# Copy to .env.local for local development (never commit real keys).
# In production, set these as Vercel Environment Variables.

# Google Gemini (primary model) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (fallback when Gemini is rate-limited or down) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Per-request model timeout and a per-instance daily cap that protects free-tier quota.
AI_TIMEOUT_MS=20000
DAILY_AI_LIMIT=300
